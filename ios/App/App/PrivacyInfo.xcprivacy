<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Privacy manifest for the Minimum Stress app target.

    The app is a Capacitor shell that loads the production web app; it runs no
    advertising SDK and does not track across apps or sites. OneSignal provides
    opt-in push and ships its own privacy manifest; its linked identifier,
    session/notification interaction, and device metadata collection is disclosed
    in App Store Connect (see docs/app-store/privacy-label.md). Server-side data
    collection is disclosed there as well, which is why this first-party target's
    NSPrivacyCollectedDataTypes remains empty.
  -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
