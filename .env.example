# Copy to .env.local and fill in. .env* is gitignored — never commit the real file.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL, from Settings → Data API. Looks like https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...), the replacement for the old anon key.
# Public by design: it ships in the browser bundle and is safe there, because
# every table it can reach is guarded by the RLS policies in
# supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), the replacement for the old service_role key.
# Bypasses RLS entirely. Server-only — it must never appear in a NEXT_PUBLIC_
# variable or be imported into a client component. Used by the routes that
# write bookings and credit_ledger, which have to be atomic with a Stripe call.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe — M4
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Shared secret for /api/cron, sent by Vercel Cron as a bearer token. Without
# it that endpoint is a public button for capturing everyone's payments early.
# Any long random string: `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Resend — M6
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# The From address on every transactional email. Must be on a domain verified
# in Resend, or Resend accepts the call and silently delivers nothing — which
# looks from inside the app exactly like a working send.
#
# Point Supabase Auth's custom SMTP at the same address, so the sign-in code
# and the booking confirmation come from one sender rather than two.
NOTIFY_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Who can open /admin. Comma-separated addresses, matched against the signed-in
# account. Empty grants nothing to nobody — the page 404s rather than saying it
# exists, so an unset variable looks exactly like the page not being there.
#
# Set it in every environment you expect to use it in, this file included: the
# local dev server reads its own copy, and a value only in Vercel means the
# queue is unreachable on the machine it was built on.
ADMIN_EMAILS=

# Where safety escalations and account-change requests are emailed. Optional —
# it falls back to the first address in ADMIN_EMAILS, because "who runs this"
# is already answered there and a second variable is a second chance to not set
# it. Set this only when reports should go somewhere other than the operator.
SAFETY_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Address search
# ---------------------------------------------------------------------------

# Google Places (New). The primary geocoder — it is the one that resolves a
# half-typed street to a real door, which is the difference between a listing
# somebody can find and a pin in the middle of a suburb.
#
# Restrict the key to the Places API and to this app's referrers. It is used
# server-side only: lookups are proxied so the key never reaches a browser,
# which is also why no geocoding host appears in the CSP.
GOOGLE_PLACES_API_KEY=

# Optional second and third opinions, tried in order when Google is unset or
# fails. Photon needs no key at all, so address search degrades rather than
# breaks. Leaving both empty is fine.
LOCATIONIQ_API_KEY=

# ---------------------------------------------------------------------------
# Map tiles
# ---------------------------------------------------------------------------

# Where the pictures behind both maps come from. Defaults to OpenStreetMap,
# which is right for development and wrong for production: those tile servers
# run on donations and their usage policy does not cover an app like this one.
# They enforce it by serving an "Access blocked" picture with a 200 beside it —
# nothing throws, no request fails, and both maps quietly turn into a wall of
# notices.
#
# Point this at a provider with a contract behind it before real traffic.
# MapTiler, Stadia Maps and Mapbox all have free tiers larger than this app
# will need for a long time. `{z}`, `{x}` and `{y}` are filled per tile, and a
# key rides in the query string:
#
#   https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#
# The CSP is built from this too, so the policy and the pictures cannot
# disagree about which host is allowed.
NEXT_PUBLIC_MAP_TILE_URL=

# The credit in the corner of both maps. Not decoration: each provider requires
# particular wording, and crediting OpenStreetMap over somebody else's tiles is
# wrong in the direction that costs money. Defaults to "© OpenStreetMap".
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ---------------------------------------------------------------------------
# Emergency contacts by SMS — not yet wired to anything
# ---------------------------------------------------------------------------

# All four are optional and unset by default. Nothing sends SMS today; these
# are read by the notification layer so the path exists when it is turned on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# Switches
# ---------------------------------------------------------------------------

# Set to "true" to run against in-memory fake data instead of Supabase. Off by
# default, and deliberately phrased so that doing nothing gives you the real
# backend.
#
# It was once the other way round — a variable that had to be set to turn the
# real backend ON. It was never set in production, so the live app served
# invented listings and accepted any verification code for three weeks, and
# every test passed the whole time. The default is the part that matters.
NEXT_PUBLIC_USE_MOCK=

# How many digits the emailed sign-in code has. Defaults to 6. It must match
# the Supabase Auth template, or the boxes on screen will not fit the code that
# arrives — which reads to the person typing as the code being wrong.
NEXT_PUBLIC_EMAIL_CODE_LENGTH=

# The address the app tells the world it lives at: canonical links, the Open
# Graph card, the installed web app's start URL. Normally unset — the code
# already knows the production domain — and set only to move the whole app to
# a new address without a deploy, or to point a staging build at itself so its
# link previews stop advertising production.
NEXT_PUBLIC_APP_URL=

# Set by Vercel, never by us. The deployment's own production hostname, used
# as the fallback for the address above when a build has no better answer.
VERCEL_PROJECT_PRODUCTION_URL=

# Jade, the chat on the marketing site.
#
# Without it the widget still answers: every common question is routed from a
# table in src/lib/jade.ts without a model call at all, and anything else falls
# through to the old ms-chat-proxy project. With it, the model call is ours —
# which model, how many tokens, how much thinking. The proxy ignored all three.
#
# Read only by src/app/api/jade/chat/route.ts, server-side. Never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
