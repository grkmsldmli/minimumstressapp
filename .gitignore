# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...except the one whose entire purpose is to be shared. `.env*` swallowed it,
# so the file listing every variable the app needs existed on one machine and
# nowhere else — which is how a variable ends up unset in production with
# nothing anywhere to say it was ever required. It holds names and reasons,
# never values; the check that it stays that way is that a value here is a
# review comment, not a build failure.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

